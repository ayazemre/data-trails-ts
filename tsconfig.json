{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist",
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts"]
}
